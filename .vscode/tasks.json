{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Devsphere: API local (8080)",
      "detail": "Modo local protegido: modelos desabilitados; API/worker permitem os fluxos leves.",
      "type": "process",
      "command": "${workspaceFolder}/tools/start-local-api.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "options": {
        "env": {
          "DEVSPHERE_INFERENCE_ENABLED": "0"
        }
      }
    },
    {
      "label": "Devsphere: worker local",
      "type": "process",
      "command": "${workspaceFolder}/tools/start-worker.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "options": {
        "env": {
          "DEVSPHERE_INFERENCE_ENABLED": "0"
        }
      },
      "detail": "Modo local protegido: modelos desabilitados; API/worker permitem os fluxos leves."
    }
  ]
