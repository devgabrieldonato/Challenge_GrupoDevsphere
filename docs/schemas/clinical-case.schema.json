{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paciente-virtual.local/schemas/clinical-case-v1.json",
  "title": "Caso clínico versionado",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "status", "patient", "learningObjectives", "items", "hypotheses", "outcome", "references"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "awaiting_human_review", "changes_requested", "approved", "published", "rejected"] },
    "patient": {
      "type": "object",
      "required": ["displayName", "age", "chiefComplaint", "context"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "age": { "type": "integer", "minimum": 0, "maximum": 130 },
        "chiefComplaint": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "learningObjectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "items": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "answer", "quality", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "type": { "enum": ["question", "exam"] },
          "title": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "quality": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "parent": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "hypotheses": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" } } } },
    "priorityEvidenceIds": { "type": "array", "items": { "type": "string" } },
    "outcome": { "type": "object", "required": ["hypothesisId", "explanation"], "properties": { "hypothesisId": { "type": "string" }, "explanation": { "type": "string" } } },
    "references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "missingData": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
